[Unit]
Description=jobsignal: запускать автоотклик hh.ru раз в час

[Timer]
# Разнесено с конвейером: тот стартует в *:07 (+ разброс до 3 минут) и
# занимает до получаса — сбор с hh, разбор, оценка. Отправка идёт в *:45,
# когда конвейер уже отработал. Замок /run/jobsignal-hh.lock у них общий, и
# пересечение теперь не сбой, а пропуск, — но лучше просто не пересекаться.
OnCalendar=*:45
# Догнать пропущенный запуск после перезагрузки или простоя.
Persistent=true
# Размазать старт, чтобы обращения к hh не шли секунда-в-секунду.
RandomizedDelaySec=120
Unit=jobsignal-hh-apply.service

[Install]
WantedBy=timers.target
