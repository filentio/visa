[Unit]
Description=jobsignal: запускать автоотклик hh.ru раз в час

[Timer]
# Десять слотов в час: 14, 19, 24 … 59 минута. Интервал между откликами
# задаёт именно таймер, а не сон внутри прогона: один прогон отправляет один
# отклик (HH_MAX_SENDS_PER_RUN=1) и живёт минуту-две, поэтому замок
# /run/jobsignal-hh.lock свободен почти всё время. Если бы пачку из десяти
# отправок с паузами по 5-6 минут делал один прогон, он держал бы замок
# почти час, и конвейер пропускал бы прогоны — вместе с разбором, оценкой и
# уведомлениями, которым hh вообще не нужен.
#
# Начало в *:14, а не в *:00 — это окно конвейера: он стартует в *:07
# (+ разброс до 3 минут) и обычно занимает около шести минут. Слот *:14
# иногда всё же попадёт на его хвост; тогда отправка увидит занятый замок и
# пропустит прогон с нулевым кодом — в этот час уйдёт девять откликов вместо
# десяти, тревоги не будет.
OnCalendar=*:14/5
# Пропущенный слот не догоняем. У конвейера Persistent=true осмыслен: прогон
# раз в час, пропуск заметен. Здесь слотов десять в час, пропуск одного не
# значит ничего — а догоняющий запуск бьёт по времени куда попало. Проверено
# 10.09: перезапуск таймера поднял отправку в 21:06:52, она заняла замок, и
# конвейер в 21:07:36 пропустил свой прогон целиком.
Persistent=false
# Разброс ±1,5 минуты: с ним интервал между откликами гуляет в пределах
# 3,5-6,5 минуты, и отправки не идут по метроному.
RandomizedDelaySec=90
Unit=jobsignal-hh-apply.service

[Install]
WantedBy=timers.target
