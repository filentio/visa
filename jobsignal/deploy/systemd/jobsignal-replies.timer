[Unit]
Description=jobsignal: проверять ответы на отклики hh.ru раз в сутки

[Timer]
# Раз в сутки достаточно: работодатель не отвечает чаще, а каждое обращение
# к hh.ru идёт с того же адреса, что сбор и отправка.
#
# 04:42, а не ровный час: туда целится вся автоматика мира. Ночь выбрана
# намеренно — в это время не работают ни конвейер вхолостую, ни отправка
# (её слоты идут круглосуточно, но ночью очередь обычно пуста), так что
# общий замок /run/jobsignal-hh.lock почти наверняка свободен.
OnCalendar=*-*-* 04:42:00
# Догнать пропущенное: прогон раз в сутки, пропуск после перезагрузки или
# простоя заметен и его стоит восполнить.
Persistent=true
RandomizedDelaySec=600
Unit=jobsignal-replies.service

[Install]
WantedBy=timers.target
