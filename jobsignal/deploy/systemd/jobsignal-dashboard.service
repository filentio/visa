[Unit]
Description=jobsignal: кабинет (127.0.0.1:5000; снаружи только через Caddy по HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jobsignal_local
ExecStart=/opt/jobsignal_local/.venv/bin/python run.py serve
# tmux эту роль не выполнил: сессия пережила процесс, дашборд молча лежал.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
