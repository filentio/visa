[Unit]
Description=jobsignal: копия базы раз в сутки

[Timer]
# 03:17 — до ночного учёта ответов (04:42) и задолго до утреннего сбора.
# Копия снимается с базы, какой она была после суток работы, и до того, как
# её начнут менять новые прогоны.
OnCalendar=*-*-* 03:17:00
# Пропущенную копию догоняем: сутки без копии — ровно та дыра, из-за
# которой 04.10 потерялись отметки за три недели.
Persistent=true
RandomizedDelaySec=300
Unit=jobsignal-backup.service

[Install]
WantedBy=timers.target
