[Unit]
Description=jobsignal: проверять входящие в телеграме каждые 5 минут

[Timer]
# Каждые пять минут: рекрутёрский бот ждёт ответа, и быстрый ответ ускоряет
# рассмотрение. Проверка стоит одного обращения к телеграму и ничего больше.
# (Прежнее обоснование — «молчание закрывает отклик за тринадцать минут» —
# оказалось неверным: тот отклик ушёл в INTERVIEW, а не в отказ.)
OnCalendar=*:0/5
# Догонять пропущенное незачем: важно текущее состояние, а не история.
Persistent=false
RandomizedDelaySec=30
Unit=jobsignal-tgwatch.service

[Install]
WantedBy=timers.target
