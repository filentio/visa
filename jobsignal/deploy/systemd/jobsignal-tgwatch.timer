[Unit]
Description=jobsignal: проверять входящие в телеграме каждые 5 минут

[Timer]
# Каждые пять минут. Это не перестраховка: 03.10 ГигаРекрутер Сбера задал
# вопрос в 22:41, а в 22:54 статус отклика сменился — тринадцать минут.
# Проверка стоит одного обращения к телеграму и ничего больше.
OnCalendar=*:0/5
# Догонять пропущенное незачем: важно текущее состояние, а не история.
Persistent=false
RandomizedDelaySec=30
Unit=jobsignal-tgwatch.service

[Install]
WantedBy=timers.target
