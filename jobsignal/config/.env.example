# Скопируй в config/.env и заполни. config/.env в .gitignore — не коммить.

# --- Telegram user-аккаунт (ОПЦИОНАЛЬНО, нужен только для Этапов 5-6: ---
# --- авто-отправка в личку и авто-трекинг ответов через MTProto). ---
# --- Для сбора вакансий (Этап 1) НЕ требуется — он идёт через t.me/s/. ---
# api_id / api_hash берутся на https://my.telegram.org -> API development tools
# ВАЖНО: используй ОТДЕЛЬНЫЙ номер, не основной (риск бана за автоматизацию).
TG_API_ID=
TG_API_HASH=
TG_PHONE=+7XXXXXXXXXX
TG_SESSION=collector

# --- Telegram-бот для уведомлений ЛИЧНО тебе (Bot API, @BotFather) ---
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# --- Выбор LLM-провайдера ---
# anthropic — облако Anthropic (ключ ниже + оплата)
# ollama    — локальная модель на Mac (бесплатно, без сети)
# gigachat  — Сбер GigaChat (из РФ, рубли, есть бесплатный лимит для физлиц)
LLM_PROVIDER=gigachat

# --- GigaChat (Сбер) ---
GIGACHAT_AUTH_KEY=          # «Авторизационные данные» (base64) из кабинета GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS   # PERS — физлица
GIGACHAT_MODEL=GigaChat            # GigaChat | GigaChat-Pro | GigaChat-Max
GIGACHAT_VERIFY_SSL=false          # сертификаты НУЦ Минцифры не в системном trust store

# --- Ollama (локально) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6   # матчинг/генерация (важно качество)
PARSER_MODEL=claude-haiku-4-5       # парсинг постов (если provider=anthropic)
PARSER_BATCH_LIMIT=200              # сколько постов парсить за один прогон

# --- Поведение ---
MATCH_THRESHOLD=70
MATCH_BATCH_LIMIT=200     # сколько вакансий оценивать матчером за прогон
OUTREACH_MODE=semi_auto   # semi_auto | full_auto

# --- Дашборд (на сервере обязательно задай пароль!) ---
DASHBOARD_PORT=5000
DASHBOARD_USER=admin
DASHBOARD_PASS=           # пусто = без пароля (локально); на публичном IP ОБЯЗАТЕЛЬНО задать

# --- БД (по умолчанию SQLite в data/) ---
# DATABASE_URL=sqlite:///./data/jobsignal.db
