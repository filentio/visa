# Секреты и сессии — никогда не коммитим
.env
config/.env
# Бэкапы .env перед правкой (config/.env.bak-20260910-204036 и подобные):
# шаблон выше их не ловит, а внутри тот же ключ, что и в оригинале.
.env.bak-*
**/config/.env.bak-*
state.json
*.pem
*.key
*.session

# Персональные данные — репозиторий публичный.
# Шаблоны без якоря: деплой лежит в подкаталоге jobsignal/, а правило вида
# config/cv_*.md срабатывает только в корне и туда не доставало.
**/config/cv_*.md
**/config/resumes/
**/master_cv.pdf

# Данные
data/
*.sqlite3
*.db
letters/
screenshots/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ОС
.DS_Store
